NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Neon PostgreSQL: use the pooled hostname for the app and the direct hostname for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB_NAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require
# Optional. Use only a separate, disposable database for Prisma integration tests.
REGISTRA_TEST_DATABASE_URL=

# SMTP credentials for real OTP and password-reset email delivery.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Gemini API access for document OCR.
GEMINI_API_KEY="your-gemini-api-key"